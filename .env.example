# Semantic search works out of the box with a local embedding model (no key).
# Set these only if you want to use Google's embedding models instead.

# GOOGLE_API_KEY=your-google-api-key
# YT_MCP_EMBED_MODEL=models/text-embedding-004

# Where the persistent vector store lives (defaults to ./.youtube_mcp_store)
# YT_MCP_STORE_PATH=/absolute/path/to/store
